#!/usr/bin/env node
'use strict'

const readline = require('node:readline/promises')
const { stdin, stdout } = require('node:process')
const { BotManager } = require('./src/bots')
const { parseTarget, resolveTarget, formatTarget } = require('./src/target')

const MAX_BOTS = 100

async function askBotCount(rl) {
  for (;;) {
    const input = (await rl.question(`Bot count (1-${MAX_BOTS}) [20]: `)).trim()
    const count = input === '' ? 20 : Number(input)
    if (Number.isInteger(count) && count >= 1 && count <= MAX_BOTS) return count
    console.log(`Enter a whole number from 1 to ${MAX_BOTS}.`)
  }
}

async function askTarget(rl) {
  for (;;) {
    const input = await rl.question('Clone server IP or domain [optional :port; domain uses Minecraft SRV]: ')
    try { return parseTarget(input) } catch (error) { console.log(error.message) }
  }
}

async function main() {
  if (process.argv.includes('--ui')) return require('./src/web-ui').startWebUI()
  if (!process.stdin.isTTY || !process.stdout.isTTY) throw new Error('Run ./mc-loadtest in an interactive terminal.')
  const rl = readline.createInterface({ input: stdin, output: stdout })
  let count, target
  try {
    console.log('\nMinecraft clone load test\n')
    count = await askBotCount(rl)
    target = await resolveTarget(await askTarget(rl))
    console.log(`\nTarget: ${formatTarget(target)}`)
    console.log(`Bots:   ${count}`)
    console.log('Mode:   send one chat marker per bot; login/register is skipped')
    const confirmation = (await rl.question('\nConfirm this is your isolated clone. Type YES to connect: ')).trim()
    if (confirmation !== 'YES') throw new Error('Confirmation did not match; no bots were started.')
  } finally {
    if (!rl.closed) rl.close()
  }

  const config = {
    host: target.host,
    port: target.port,
    version: '26.3',
    protocolAdapter: 'experimental-26.3',
    maxBots: count,
    spawnRate: 1,
    maxReconnects: 5,
    reconnectDelayMs: 1500,
    seed: Date.now(),
    auth: { chatTestOnly: true, chatTestDelayMs: 3000, chatTestMessage: 'LoadTest: {username} chat test' },
    movement: { intervalMs: 1500, radius: 32 }
  }

  let manager
  let chatTestMessagesSent = 0
  try {
    require.resolve('@wp2508/mineflayer')
    manager = new BotManager(config, event => {
      if (event.type === 'chat_test_sent') { chatTestMessagesSent++; console.log(`\nChat test sent: ${event.username}`) }
      else if (event.type === 'chat_test_error') console.log(`\nChat test failed: ${event.username}`)
      else if (event.type === 'chat_message') console.log(`\n[${event.username} ← server] ${event.message}`)
      else if (event.type === 'authenticated') console.log(`\nAuthenticated: ${event.username}`)
      else if (event.type === 'auth_failure') console.log(`\nAuth failed: ${event.username} (${event.reason})`)
      else if (event.type === 'error') console.log(`\nClient error: ${event.username}`)
      else if (event.type === 'kicked') console.log(`\nKicked: ${event.username}`)
      else if (event.type === 'disconnected' && !event.intentional) console.log(`\nDisconnected: ${event.username} (${event.reason})`)
    })
  } catch {
    throw new Error('Missing @wp2508/mineflayer. Install dependencies first with: npm install')
  }

  console.log('\nStarting connections at one bot per second. Press Ctrl-C to stop.\n')
  manager.setTarget(count, 'idle')
  let done = false
  let lastLineLength = 0
  const render = () => {
    const s = manager.snapshot()
    const line = `Connected ${s.connected}/${count} · chat packets sent ${chatTestMessagesSent} · failed ${s.failedConnections}`
    stdout.write(`\r${line.padEnd(lastLineLength, ' ')}`)
    lastLineLength = Math.max(lastLineLength, line.length)
  }
  const status = setInterval(render, 1000)
  render()
  await new Promise(resolve => {
    const stop = () => {
      if (done) return
      done = true
      clearInterval(status)
      manager.stop()
      process.off('SIGINT', stop)
      process.off('SIGTERM', stop)
      stdout.write('\n\nBots disconnected.\n')
      const s = manager.snapshot()
      console.log(`Chat test packets sent: ${chatTestMessagesSent} · failed connections: ${s.failedConnections}`)
      resolve()
    }
    process.once('SIGINT', stop)
    process.once('SIGTERM', stop)
  })
}

main().catch(error => {
  console.error(`\n${error.message}`)
  process.exitCode = 1
})
